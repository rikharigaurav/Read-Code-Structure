{
  "mcpServers": {
    "read-code-structure": {
      "type": "stdio",
      "command": "python",
      "args": ["mcp_server.py"],
      "env": {
        "NEO4J_URI": "${NEO4J_URI}",
        "NEO4J_USERNAME": "${NEO4J_USERNAME}",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
